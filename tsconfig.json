{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@orman/headless-next/form": ["src/components/form.tsx"],
      "@orman/headless-next/captcha": ["src/components/captcha.tsx"]
    }
  },
  "include": ["src", "tests", "*.ts"]
}
